NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Needed by `npm run seed` and to look up the other party's email for
# notifications. Browsing and every member action run on the anon key.
SUPABASE_SERVICE_ROLE_KEY=
# KYC provider (to be chosen)
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# Email (Resend). Without a key, notifications log instead of sending.
RESEND_API_KEY=
EMAIL_FROM="HouseSwap <stays@yourdomain.com>"
# Used in links inside emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for /api/cron/reminders. Vercel Cron sends it automatically.
CRON_SECRET=

# Placeholder ID verification. Never honoured in production, see
# selfVerifyAllowed() in src/lib/actions/auth.ts. Delete once the KYC
# webhook is live.
ALLOW_SELF_VERIFY=false

# WhatsApp and SMS (Twilio does both). Neither can be switched on until the
# registrations below are done; without them the senders log and report
# "not sent" rather than pretending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SMS to Indian numbers: TRAI requires DLT registration of the sender and of
# every template before operators will deliver transactional messages.
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_TEMPLATE_REQUEST=
SMS_TEMPLATE_APPROVED=
SMS_TEMPLATE_DECLINED=
SMS_TEMPLATE_REMINDER=

# WhatsApp: business-initiated messages need templates approved by Meta.
WHATSAPP_FROM=
WHATSAPP_TEMPLATE_REQUEST=
WHATSAPP_TEMPLATE_APPROVED=
WHATSAPP_TEMPLATE_DECLINED=
WHATSAPP_TEMPLATE_REMINDER=
